{
  "name": "flipback",
  "version": "0.2.0",
  "description": "A Claude Code hook that reads the conversation when an agent stops, decides whether the work was actually finished, and puts it back on when it was not.",
  "keywords": [
    "claude",
    "claude-code",
    "claude-code-hook",
    "claude-code-skill",
    "ai-agents",
    "agent",
    "stop-hook",
    "completion",
    "autonomy"
  ],
  "license": "MIT",
  "author": "Nir Feinstein",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fainir/flipback.git"
  },
  "homepage": "https://github.com/fainir/flipback#readme",
  "bugs": {
    "url": "https://github.com/fainir/flipback/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "flipback": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "assets/logo.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/src/cli.js",
    "prepublishOnly": "npm run build && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "node dist/src/cli.js check",
    "doctor": "node dist/src/cli.js doctor"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
